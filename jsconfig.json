{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components": ["src/components/index.js"],
      "@components/*": ["src/components/*"],
      "@config": ["src/config.js"],
      "@hooks": ["src/hooks/index.js"],
      "@hooks/*": ["src/hooks/*"],
      "@utils": ["src/utils/index.js"],
      "@utils/*": ["src/utils/*"]
    }
  },
  "exclude": ["node_modules", ".next", "out"]
}
