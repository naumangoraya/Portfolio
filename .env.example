# Copy to .env.local and fill in. Never commit .env.local.
# This file is the single source of truth for required configuration.

# --- Database (required) ---
# MongoDB Atlas connection string, including the database name.
MONGODB_URI=

# --- Auth (required) ---
# Long random string. Generate with: openssl rand -hex 48
JWT_SECRET=

# --- Cloudinary (required for image and resume uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Contact form email (required for /api/contact/submit) ---
# Without these the contact form returns 500.
RESEND_API_KEY=
NOTIFICATION_EMAIL=
# Optional: a verified sender on your own domain. Defaults to Resend's sandbox
# address, which only delivers to the Resend account owner.
CONTACT_FROM_EMAIL=

# --- Public site details (inlined into the client bundle) ---
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# --- Admin seeding (used only by `npm run seed:admin`) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
